# Vercel Production Environment Variables
# Copy these to Vercel Dashboard -> Project Settings -> Environment Variables

# Database (PlanetScale MySQL or Vercel Postgres)
# For PlanetScale: Get from https://planetscale.com
# DATABASE_URL="mysql://username:password@host/database?sslaccept=strict"

# For Vercel Postgres (Neon):
# DATABASE_URL="postgresql://username:password@host/database?sslmode=require"

# JWT Secret (same as local)
JWT_SECRET="dad84b60f4fc3f0423ce735ffc5fcf302036baea201331bbcc5ac21ea46fb8a7"

# Email Configuration (optional)
EMAIL_USER="your-email@gmail.com"
EMAIL_PASSWORD="your-app-password"

# Next.js
NEXT_PUBLIC_SITE_URL="https://your-domain.vercel.app"
